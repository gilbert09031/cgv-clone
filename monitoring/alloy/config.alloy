loki.source.file "app" {
  targets = [{
    "__path__"     = "/var/log/cgv/application.log",
    "service_name" = "cgv-app",
    "environment"  = "local",
  }]
  forward_to = [loki.write.local.receiver]

  file_match {
    enabled     = true
    sync_period = "5s"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
